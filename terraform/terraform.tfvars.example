aws_region         = "ca-central-1"
name               = "dxl-word-grid"
vpc_id             = "vpc-xxxxxxxx"
public_subnet_ids  = ["subnet-aaa", "subnet-bbb"]
private_subnet_ids = ["subnet-aaa", "subnet-bbb"]
assign_public_ip   = true
